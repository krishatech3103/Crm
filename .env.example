# LeadFlow CRM Environment Variables
# Create a .env file locally with your Supabase Project details

# Public Supabase URL (safe for browser exposure)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co

# Public Supabase Anonymous API Key (safe for browser exposure)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# IMPORTANT SECURITY NOTE:
# NEVER expose your Supabase service_role key in client-side code, .env file, or GitHub repository!
